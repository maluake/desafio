{
  "title": "Getnet Multi-Agent Support",
  "uid": "getnet-ma",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / min by final agent",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(chat_requests_total[1m])*60) by (final_agent)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p50 / p95 latency (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(chat_request_latency_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Router intents",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(router_decisions_total[5m])) by (intent)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Router confidence p50",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(router_confidence_bucket[15m])) by (le))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Agent latency p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_latency_seconds_bucket[5m])) by (le, agent))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tool calls by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(tool_calls_total[5m])) by (tool, status)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM tokens / min",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(llm_tokens_total[1m])*60) by (kind)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM calls by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum(rate(llm_calls_total[5m])) by (status)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Fallbacks to offline (agent errors)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(rate(agent_errors_total[5m])) by (agent)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Guardrail events",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum(rate(guardrail_events_total[5m])) by (stage, flag)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Escalations by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum(increase(escalations_total[1h])) by (reason)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "RAG hit rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum(rate(rag_retrievals_total{hit=\"hit\"}[15m])) / sum(rate(rag_retrievals_total[15m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "User feedback",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "sum(increase(user_feedback_total[1h])) by (rating)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ]
    }
  ]
}