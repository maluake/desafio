# --- LLM (leave ANTHROPIC_API_KEY empty to run the deterministic offline mode) ---
ANTHROPIC_API_KEY=
LLM_PROVIDER=auto            # auto | anthropic | offline
LLM_MODEL=claude-opus-5-5
ROUTER_MODEL=claude-opus-5-5
ROUTER_EFFORT=low
AGENT_EFFORT=medium
LLM_REFUSAL_FALLBACK=true

# --- RAG ---
INGEST_ON_STARTUP=seed       # none | seed | crawl (crawl getnet.net at startup when the index is missing)
EMBEDDINGS_BACKEND=tfidf     # tfidf | fastembed (pip install fastembed)
RETRIEVAL_TOP_K=5

# --- External tools ---
WEB_SEARCH_PROVIDER=ddgs     # ddgs | tavily | none
TAVILY_API_KEY=

# --- Human handoff (Slack / Teams incoming webhook) ---
ESCALATION_WEBHOOK_URL=

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
EXPOSE_TRACE=true
